datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MediaKind {
  video
  image
}

enum AspectRatio {
  NINE_SIXTEEN
  ONE_ONE
  SIXTEEN_NINE
}

model CityTheme {
  id               Int      @id @default(autoincrement())
  iata             String   @db.VarChar(3)
  themeSlug        String   @db.VarChar(32)
  isEnabled        Boolean  @default(false)
  minMediaRequired Int      @default(5)
  maxMediaAllowed  Int      @default(10)
  notes            String?
  reels            Reel[]

  @@unique([iata, themeSlug])
  @@index([iata])
  @@index([themeSlug])
}

model Reel {
  id        Int         @id @default(autoincrement())
  iata      String      @db.VarChar(3)
  themeSlug String      @db.VarChar(32)
  title     String?
  caption   String?
  language  String      @default("en") @db.VarChar(8)
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  media     ReelMedia[]
  theme     CityTheme?  @relation(fields: [iata, themeSlug], references: [iata, themeSlug], onDelete: SetNull)

  @@index([iata, themeSlug, isActive])
}

model ReelMedia {
  id         Int        @id @default(autoincrement())
  reelId     Int
  kind       MediaKind
  sourceUrl  String
  providerId String?
  aspect     AspectRatio @default(NINE_SIXTEEN)
  durationMs Int?
  width      Int?
  height     Int?
  altText    String?
  credit     String?
  license    String?
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
  reel       Reel       @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId, isActive])
}

model SearchAnalytics {
  id          Int      @id @default(autoincrement())
  query       String   @unique @db.VarChar(255)
  searchCount Int      @default(1) @map("search_count")
  resultCount Int      @default(0) @map("result_count")
  searchDate  DateTime @default(now()) @map("search_date")
  lastSearched DateTime @default(now()) @map("last_searched")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([query])
  @@index([searchCount(sort: Desc)])
  @@index([lastSearched(sort: Desc)])
  @@map("search_analytics")
}
