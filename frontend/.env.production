# PRODUCTION ENVIRONMENT - WAVE 1 EU/ASIA LAUNCH
# CRITICAL: These settings are for live production deployment
# DO NOT commit this file to Git with real secrets

# === DATABASE (MUST BE ROTATED - CURRENT CREDENTIALS EXPOSED) ===
# TODO: Create new Neon database with fresh credentials before deployment
DATABASE_URL=postgresql://NEW_PROD_USER:NEW_PROD_PASSWORD@NEW_PROD_HOST/NEW_PROD_DB?sslmode=require
DIRECT_URL=postgresql://NEW_PROD_USER:NEW_PROD_PASSWORD@NEW_PROD_HOST/NEW_PROD_DB?sslmode=require

# === PRODUCTION SECRETS (Generate fresh 64-character secrets) ===
JWT_SECRET=REPLACE_WITH_FRESH_64_CHAR_SECRET_FOR_PRODUCTION_JWT_TOKENS_XyZ9
USER_AUTH_JWT_SECRET=REPLACE_WITH_FRESH_64_CHAR_SECRET_FOR_USER_AUTH_AbC8
ENCRYPTION_KEY=REPLACE_WITH_FRESH_64_CHAR_SECRET_FOR_DATA_ENCRYPTION_DeF7
ADMIN_JWT_SECRET=REPLACE_WITH_FRESH_64_CHAR_SECRET_FOR_ADMIN_PANEL_GhI6

# === AFFILIATE NETWORK HMAC SECRETS (Get from account managers) ===
IMPACT_SIGNATURE_SECRET=GET_REAL_HMAC_SECRET_FROM_IMPACT_ACCOUNT_MANAGER_64_CHARS
CJ_SIGNATURE_SECRET=GET_REAL_HMAC_SECRET_FROM_CJ_ACCOUNT_MANAGER_64_CHARS
CJ_ADVERTISER_IDS=Qantas,VirginAustralia,AirNewZealand,BritishAirways,SingaporeAirlines

# === WAVE 1 EU/ASIA FEATURE FLAGS - CONSERVATIVE LAUNCH ===
FEATURE_METASEARCH_ENABLED=true
FEATURE_METASEARCH_PROVIDERS_ENABLED=true
FEATURE_CLICK_TRACKING_ENABLED=true
FEATURE_REPRICE_ON_SELECT_ENABLED=true

# Market toggles - Wave 1 EU/Asia ONLY
FEATURE_MARKET_GB_ENABLED=true
FEATURE_MARKET_SG_ENABLED=true
FEATURE_MARKET_JP_ENABLED=true
FEATURE_MARKET_AU_ENABLED=false
FEATURE_MARKET_NZ_ENABLED=false

# Security enforcement - STRICT for production
FEATURE_POSTBACK_ENFORCE_SIGNATURE=true
FEATURE_RATE_LIMITING_ENABLED=true
FEATURE_IP_ALLOWLIST_ENFORCEMENT=true

# Provider toggles - Wave 1 conservative start
FEATURE_PROVIDER_BRITISH_AIRWAYS_ENABLED=true
FEATURE_PROVIDER_SINGAPORE_AIRLINES_ENABLED=true
FEATURE_PROVIDER_KAYAK_JP_ENABLED=true
FEATURE_PROVIDER_SKYSCANNER_GB_ENABLED=true

# Monitoring and safety
FEATURE_SYNTHETIC_MONITOR_ENABLED=true
FEATURE_PERFORMANCE_MONITORING_ENABLED=true
FEATURE_AUTO_ROLLBACK_ENABLED=true

# Rollout constraints - Conservative Wave 1 limits
ROLLOUT_MAX_DAILY_CLICKS=1000
ROLLOUT_MAX_DAILY_REVENUE=500
FEATURE_ROLLOUT_WAVE_1_ENABLED=true
FEATURE_ROLLOUT_WAVE_2_ENABLED=false
FEATURE_ROLLOUT_WAVE_3_ENABLED=false

# Production application settings
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_DEBUG_LOGGING=false
NEXT_PUBLIC_ENABLE_MOCK_FALLBACKS=false

# Admin Configuration
ADMIN_JWT_ISSUER=spontra-admin-prod
ADMIN_JWT_AUDIENCE=spontra-admin-panel

# Rate limiting - production values
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Email service
RESEND_FROM_EMAIL=noreply@your-production-domain.com
NEXT_PUBLIC_APP_NAME=Spontra

# External APIs - production keys
AMADEUS_CLIENT_ID=YOUR_PRODUCTION_AMADEUS_CLIENT_ID
AMADEUS_CLIENT_SECRET=YOUR_PRODUCTION_AMADEUS_CLIENT_SECRET
AMADEUS_ENVIRONMENT=production

# Optional campaign/placement labels
AFF_CAMPAIGN_ID=spontra-prod
AFF_PLACEMENT_ID=web-prod