# PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env.production and populate with actual production secrets
# NEVER commit this file with real values to Git

# === CRITICAL: ROTATE THESE DATABASE CREDENTIALS ===
# Current exposed credentials MUST be rotated before production deployment
# DATABASE_URL=postgresql://NEW_USER:NEW_PASSWORD@NEW_HOST/NEW_DB?sslmode=require
# DIRECT_URL=postgresql://NEW_USER:NEW_PASSWORD@NEW_HOST/NEW_DB?sslmode=require

# === PRODUCTION SECRETS (Generate new 64-character secrets) ===
# JWT_SECRET=GENERATE_NEW_64_CHAR_SECRET_FOR_PRODUCTION
# USER_AUTH_JWT_SECRET=GENERATE_NEW_64_CHAR_SECRET_FOR_PRODUCTION  
# ENCRYPTION_KEY=GENERATE_NEW_64_CHAR_SECRET_FOR_PRODUCTION
# ADMIN_JWT_SECRET=GENERATE_NEW_64_CHAR_SECRET_FOR_PRODUCTION

# === AFFILIATE NETWORK SECURITY (Production HMAC secrets) ===
# IMPACT_SIGNATURE_SECRET=GET_FROM_IMPACT_ACCOUNT_MANAGER
# CJ_SIGNATURE_SECRET=GET_FROM_CJ_ACCOUNT_MANAGER
# CJ_ADVERTISER_IDS=Qantas,VirginAustralia,AirNewZealand,BritishAirways,SingaporeAirlines

# === WAVE 1 EU/ASIA FEATURE FLAGS ===
FEATURE_METASEARCH_ENABLED=true
FEATURE_METASEARCH_PROVIDERS_ENABLED=true
FEATURE_CLICK_TRACKING_ENABLED=true
FEATURE_REPRICE_ON_SELECT_ENABLED=true

# Market toggles - Wave 1 EU/Asia only
FEATURE_MARKET_GB_ENABLED=true
FEATURE_MARKET_SG_ENABLED=true  
FEATURE_MARKET_JP_ENABLED=true
FEATURE_MARKET_AU_ENABLED=false
FEATURE_MARKET_NZ_ENABLED=false

# Security enforcement - STRICT for production
FEATURE_POSTBACK_ENFORCE_SIGNATURE=true
FEATURE_RATE_LIMITING_ENABLED=true
FEATURE_IP_ALLOWLIST_ENFORCEMENT=true

# Provider toggles - Wave 1 conservative start
FEATURE_PROVIDER_BRITISH_AIRWAYS_ENABLED=true
FEATURE_PROVIDER_SINGAPORE_AIRLINES_ENABLED=true
FEATURE_PROVIDER_KAYAK_JP_ENABLED=true
FEATURE_PROVIDER_SKYSCANNER_GB_ENABLED=true

# Monitoring and safety
FEATURE_SYNTHETIC_MONITOR_ENABLED=true
FEATURE_PERFORMANCE_MONITORING_ENABLED=true
FEATURE_AUTO_ROLLBACK_ENABLED=true

# Rollout constraints
ROLLOUT_MAX_DAILY_CLICKS=1000
ROLLOUT_MAX_DAILY_REVENUE=500

# Production application settings
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_DEBUG_LOGGING=false

# Rate limiting - production values
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Email service
RESEND_FROM_EMAIL=noreply@your-production-domain.com
NEXT_PUBLIC_APP_NAME=Spontra

# External APIs - production keys
# AMADEUS_CLIENT_ID=YOUR_PRODUCTION_AMADEUS_ID
# AMADEUS_CLIENT_SECRET=YOUR_PRODUCTION_AMADEUS_SECRET
AMADEUS_ENVIRONMENT=production

# Admin API Security
ADMIN_API_KEY=GENERATE_SECURE_64_CHAR_API_KEY_FOR_ADMIN_DASHBOARDS
ADMIN_IP_GUARD=true

# === ENTERPRISE RATE LIMITING (Vercel KV) ===
# KV_URL=redis://your-kv-instance.kv.vercel-storage.com
# KV_REST_API_URL=https://your-kv-instance.kv.vercel-storage.com/rest
# KV_REST_API_TOKEN=your_kv_rest_api_token
# KV_REST_API_READ_ONLY_TOKEN=your_kv_read_only_token

# === SLACK ALERTING FOR CRITICAL ISSUES ===
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# ALERT_WEBHOOK_URL=https://your-custom-webhook-endpoint.com/alerts

# === DATA HYGIENE AND PARTITIONING ===
# Run nightly: 0 2 * * * cd /app && npm run hygiene:nightly
FEATURE_DATA_HYGIENE_ENABLED=true
DATA_RETENTION_CLICKS_DAYS=90
DATA_RETENTION_CONVERSIONS_DAYS=365