datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ESSENTIAL MODELS ONLY - ULTRA MVP
// ============================================================================

enum UserRole {
  user
  admin
}

// Core user model
model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  role             UserRole @default(user)
  isEmailVerified  Boolean  @default(false) @map("is_email_verified")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  savedSearches           SavedSearch[]
  favoriteDestinations    FavoriteDestination[]
  creator                 Creator?
  videoViews              VideoView[]

  @@map("users")
}

// Email verification tokens
model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Saved searches for logged-in users
model SavedSearch {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  originAirport      String   @map("origin_airport")
  theme              String?
  minFlightTime      Int?     @map("min_flight_time")
  maxFlightTime      Int?     @map("max_flight_time")
  priceAlertEnabled  Boolean  @default(false) @map("price_alert_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

// Favorite destinations for logged-in users
model FavoriteDestination {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  destinationId String   @map("destination_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([userId])
  @@map("favorite_destinations")
}

// Affiliate click tracking for commission attribution
model AffiliateClick {
  id            String    @id @default(uuid())
  userId        String?   @map("user_id")  // Optional - null for anonymous users
  sessionId     String?   @map("session_id")  // For anonymous user tracking
  destinationId String?   @map("destination_id")  // Which destination they were viewing
  partner       String    // "kiwi", "travelpayouts", "skyscanner", "kayak"
  affiliateId   String?   @map("affiliate_id")  // Your affiliate ID for that partner
  clickUrl      String    @map("click_url") @db.Text  // Full affiliate URL clicked

  // Search context (what they were searching for)
  originAirport      String?  @map("origin_airport")
  destinationAirport String?  @map("destination_airport")
  departureDate      String?  @map("departure_date")
  returnDate         String?  @map("return_date")

  // Price shown to user
  displayedPrice     Decimal? @map("displayed_price") @db.Decimal(10, 2)
  currency           String   @default("USD")

  // Tracking data
  referrer      String?   @db.Text  // HTTP referrer
  ipAddress     String?   @map("ip_address")  // For fraud detection
  userAgent     String?   @map("user_agent") @db.Text  // Browser/device info

  // Conversion tracking (updated by webhooks/postbacks if partner supports it)
  converted     Boolean   @default(false)  // Did this click result in a booking?
  convertedAt   DateTime? @map("converted_at")  // When conversion happened
  commission    Decimal?  @db.Decimal(10, 2)  // Commission earned (if known)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  creatorEarnings CreatorEarning[]

  @@index([userId])
  @@index([sessionId])
  @@index([destinationId])
  @@index([partner])
  @@index([createdAt])
  @@index([converted])
  @@index([partner, createdAt])
  @@map("affiliate_clicks")
}

// Airport data
model Airport {
  id           String   @id @default(uuid())
  iataCode     String   @unique @map("iata_code")
  name         String
  city         String
  country      String
  latitude     Decimal?
  longitude    Decimal?
  isActive        Boolean  @default(true) @map("is_active")
  isSearchable    Boolean  @default(false) @map("is_searchable")
  passengerVolume Int      @default(0) @map("passenger_volume") // Annual passengers (millions)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  originFlights      FlightRoute[]        @relation("OriginAirport")
  destinationFlights FlightRoute[]        @relation("DestinationAirport")
  destinations       DestinationAirport[]

  @@index([isSearchable])
  @@index([city])
  @@index([country])
  @@index([passengerVolume(sort: Desc)])
  @@index([isActive, isSearchable])
  @@map("airports")
}

// Flight routes and durations
model FlightRoute {
  id                        String    @id @default(uuid())
  originAirportCode         String    @map("origin_airport_code")
  destinationAirportCode    String    @map("destination_airport_code")
  totalDurationMinutes      Int       @map("total_duration_minutes")

  // Route verification fields
  isDirect                  Boolean?  @map("is_direct")           // null = unknown, true = direct flight exists, false = connections only
  isEstimated               Boolean   @default(true) @map("is_estimated")  // true = calculated estimate, false = real API data
  dataSource                String?   @map("data_source")         // "estimated", "amadeus", etc.
  lastUpdated               DateTime? @map("last_updated")        // When route data was last updated from API

  originAirport      Airport @relation("OriginAirport", fields: [originAirportCode], references: [iataCode])
  destinationAirport Airport @relation("DestinationAirport", fields: [destinationAirportCode], references: [iataCode])

  @@unique([originAirportCode, destinationAirportCode])
  @@index([isDirect])
  @@index([isEstimated])
  @@index([totalDurationMinutes])
  @@index([originAirportCode, totalDurationMinutes])
  @@index([destinationAirportCode])
  @@map("flight_routes")
}

// Countries
model Country {
  id           String        @id @default(uuid())
  name         String        @unique
  code         String        @unique  // ISO code: "US", "FR", "JP"
  imageUrl     String?       @map("image_url")  // Admin-uploaded country hero image
  mapSvg       String?       @map("map_svg") @db.Text  // SVG code for country map outline
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  destinations Destination[]

  @@map("countries")
}

// Destinations with themes
model Destination {
  id              String     @id @default(uuid())
  airportCode     String?    @map("airport_code")  // Deprecated - kept for migration
  cityName        String     @map("city_name")
  countryName     String?    @map("country_name")  // Deprecated - kept for migration
  countryId       String?    @map("country_id")
  description     String?
  imageUrl        String?    @map("image_url")
  popularityScore Decimal?   @map("popularity_score")

  // SEO & URL fields
  slug            String?    @unique  // URL-friendly slug (e.g., "los-angeles")
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")

  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  country              Country?               @relation(fields: [countryId], references: [id])
  themePOIs            ThemePOI[]
  airports             DestinationAirport[]
  favoritedBy          FavoriteDestination[]
  hotels               Hotel[]

  @@index([countryId])
  @@index([cityName])
  @@index([popularityScore(sort: Desc)])
  @@index([slug])
  @@map("destinations")
}

// Many-to-many relationship between Destinations and Airports
model DestinationAirport {
  id            String      @id @default(uuid())
  destinationId String      @map("destination_id")
  airportCode   String      @map("airport_code")
  isPrimary     Boolean     @default(false) @map("is_primary")
  createdAt     DateTime    @default(now()) @map("created_at")

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  airport       Airport     @relation(fields: [airportCode], references: [iataCode], onDelete: Cascade)

  @@unique([destinationId, airportCode])
  @@index([destinationId])
  @@index([airportCode])
  @@map("destination_airports")
}

// Theme-specific Points of Interest for destinations
model ThemePOI {
  id              String      @id @default(uuid())
  destinationId   String      @map("destination_id")
  theme           String      // "adventure", "nature", "vibe", "indulge", "discover"
  name            String
  description     String?
  videoUrl        String?     @map("video_url")  // DEPRECATED: Use POIVideo relation instead
  latitude        Decimal?
  longitude       Decimal?
  displayOrder    Int         @default(0) @map("display_order")

  // SEO Fields
  caption         String?     @db.Text // Instagram-style caption (50-100 words) for SEO and social
  altText         String?     @map("alt_text") @db.VarChar(255) // Image alt text for accessibility & SEO
  instagramUrl    String?     @map("instagram_url") // Link to Instagram post if applicable
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  destination     Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  videos          POIVideo[]

  @@index([destinationId, theme])
  @@index([theme])
  @@index([destinationId, displayOrder])
  @@map("theme_pois")
}

// Multiple videos per POI (YouTube Shorts feed)
model POIVideo {
  id              String      @id @default(uuid())
  poiId           String      @map("poi_id")
  videoUrl        String      @map("video_url")
  displayOrder    Int         @default(0) @map("display_order")

  // Creator attribution (UGC)
  creatorId       String?     @map("creator_id")

  // Moderation status
  status          String      @default("pending") // "pending" | "approved" | "rejected"
  rejectionReason String?     @map("rejection_reason") @db.Text

  // YouTube channel attribution (for proper creator credit)
  youtubeChannelName  String?  @map("youtube_channel_name") @db.VarChar(255)
  youtubeChannelUrl   String?  @map("youtube_channel_url") @db.VarChar(500)
  youtubeChannelId    String?  @map("youtube_channel_id") @db.VarChar(100)

  // SEO Fields
  caption         String?     @db.Text // Instagram-style caption (50-100 words) for SEO and social
  altText         String?     @map("alt_text") @db.VarChar(255) // Image alt text for accessibility & SEO
  instagramUrl    String?     @map("instagram_url") // Link to Instagram post if applicable
  createdAt       DateTime    @default(now()) @map("created_at")

  poi             ThemePOI    @relation(fields: [poiId], references: [id], onDelete: Cascade)
  creator         Creator?    @relation(fields: [creatorId], references: [id])
  views           VideoView[]
  earnings        CreatorEarning[]

  @@index([poiId])
  @@index([creatorId])
  @@index([status])
  @@map("poi_videos")
}

// Hotels
model Hotel {
  id              String   @id @default(uuid())
  name            String
  cityName        String   @map("city_name")
  countryId       String?  @map("country_id")
  destinationId   String?  @map("destination_id")

  // Spontra theme integration
  primaryTheme    String   @map("primary_theme") // "adventure", "nature", "vibe", "indulge", "discover"

  // Basic info (manual entry for MVP)
  description     String?  @db.Text
  address         String?
  pricePerNight   Decimal? @map("price_per_night") @db.Decimal(10, 2)
  priceLevel      Int      @default(3) @map("price_level") // 1-5 for $ to $$$$$
  rating          Decimal? @db.Decimal(3, 2) // 0-5 stars

  // Images
  mainImageUrl    String?  @map("main_image_url") // Circular preview image
  imageUrls       String[] @map("image_urls") // Gallery images

  // Multi-provider affiliate links (2015 design approach)
  bookingComUrl   String?  @map("booking_com_url") @db.Text
  expediaUrl      String?  @map("expedia_url") @db.Text
  hotelsDotComUrl String?  @map("hotels_dot_com_url") @db.Text

  // Admin
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  destination     Destination? @relation(fields: [destinationId], references: [id])

  @@index([cityName, primaryTheme])
  @@index([destinationId])
  @@index([isActive])
  @@index([primaryTheme])
  @@index([isActive, priceLevel])
  @@map("hotels")
}

// Basic search sessions
model SearchSession {
  id               String    @id @default(uuid())
  originAirport    String?   @map("origin_airport")
  destinationAirport String? @map("destination_airport")
  departureDate    String?   @map("departure_date")
  returnDate       String?   @map("return_date")
  passengers       Int       @default(1)
  preferences      Json?
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("search_sessions")
}

// Flight offer caching for Amadeus API responses
model OfferCache {
  id            String   @id @default(cuid())
  queryHash     String   @map("query_hash") @db.VarChar(64)
  market        String
  query         Json         // NormalizedQuery
  offers        Json         // FlightOffer[]
  offerCount    Int      @map("offer_count")
  dataSource    String   @default("amadeus") @map("data_source")
  isStale       Boolean  @default(false) @map("is_stale")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([queryHash])
  @@index([expiresAt, isStale])
  @@map("offer_cache")
}

// ============================================================================
// UGC CREATOR SYSTEM
// ============================================================================

enum CreatorTier {
  new      // 5% commission share
  active   // 8% commission share
  top      // 12% commission share
  elite    // 15% commission share
}

// Creator profiles (extends User)
model Creator {
  id              String      @id @default(uuid())
  userId          String      @unique @map("user_id")
  displayName     String      @map("display_name")
  bio             String?     @db.Text
  instagramHandle String?     @map("instagram_handle")
  tiktokHandle    String?     @map("tiktok_handle")
  tier            CreatorTier @default(new)
  totalEarnings   Decimal     @default(0) @map("total_earnings") @db.Decimal(10, 2)
  isVerified      Boolean     @default(false) @map("is_verified")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Payment Information
  payoutMethod       String?   @map("payout_method") // "stripe" | "wise" | "manual"
  stripeAccountId    String?   @map("stripe_account_id") // Stripe Connect account ID
  wiseRecipientId    String?   @map("wise_recipient_id") // Wise recipient ID (fallback)

  // Banking (encrypted in application layer)
  bankAccountNumber  String?   @map("bank_account_number") @db.VarChar(255)
  bankRoutingNumber  String?   @map("bank_routing_number") @db.VarChar(255)
  bankAccountName    String?   @map("bank_account_name")

  // Tax & Compliance
  taxId              String?   @map("tax_id") @db.VarChar(255) // SSN/EIN (encrypted)
  taxIdVerified      Boolean   @default(false) @map("tax_id_verified")
  w9FormSubmitted    Boolean   @default(false) @map("w9_form_submitted")
  w9FormUrl          String?   @map("w9_form_url") // S3/storage URL
  taxCountry         String    @default("US") @map("tax_country")

  // Payout Settings
  payoutMinimum      Decimal   @default(25) @map("payout_minimum") @db.Decimal(10, 2)
  payoutSchedule     String    @default("monthly") @map("payout_schedule") // "weekly" | "biweekly" | "monthly"
  lastPayoutAt       DateTime? @map("last_payout_at")
  pendingPayout      Decimal   @default(0) @map("pending_payout") @db.Decimal(10, 2)

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos          POIVideo[]
  earnings        CreatorEarning[]
  videoViews      VideoView[]
  payouts         Payout[]

  @@index([tier])
  @@index([totalEarnings])
  @@map("creators")
}

// Track video views for attribution
model VideoView {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")        // Nullable for anonymous
  sessionId     String   @map("session_id")     // Track anonymous users
  videoId       String   @map("video_id")
  creatorId     String?  @map("creator_id")     // Denormalized for fast queries
  destinationId String   @map("destination_id") // Denormalized for fast queries
  viewedAt      DateTime @default(now()) @map("viewed_at")

  user    User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   POIVideo  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  creator Creator?  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([userId, destinationId, viewedAt])
  @@index([sessionId, destinationId, viewedAt])
  @@index([videoId])
  @@index([creatorId])
  @@index([creatorId, viewedAt(sort: Desc)])
  @@map("video_views")
}

// Creator earnings from bookings
model CreatorEarning {
  id           String   @id @default(uuid())
  creatorId    String   @map("creator_id")
  videoId      String   @map("video_id")
  affiliateClickId String? @map("affiliate_click_id") // Link to booking
  amount       Decimal  @db.Decimal(10, 2)
  commission   Decimal  @db.Decimal(10, 2)       // Total commission from booking
  shareWeight  Decimal  @db.Decimal(5, 4)        // e.g., 0.1667 = 16.67%
  tierRate     Decimal  @db.Decimal(5, 4)        // Creator's tier rate at time of earning
  earnedAt     DateTime @default(now()) @map("earned_at")

  // Payout tracking
  payoutId       String?   @map("payout_id")
  isPaid         Boolean   @default(false) @map("is_paid")
  paidAt         DateTime? @map("paid_at")
  holdReleaseAt  DateTime? @map("hold_release_at") // When hold period ends (60 days default)

  creator        Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  video          POIVideo        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  affiliateClick AffiliateClick? @relation(fields: [affiliateClickId], references: [id], onDelete: SetNull)
  payout         Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([creatorId, earnedAt])
  @@index([creatorId, isPaid])
  @@index([videoId])
  @@index([affiliateClickId])
  @@index([holdReleaseAt])
  @@index([holdReleaseAt, isPaid])
  @@index([isPaid, earnedAt])
  @@map("creator_earnings")
}

// Payout records - track actual payments to creators
model Payout {
  id                String    @id @default(uuid())
  creatorId         String    @map("creator_id")
  amount            Decimal   @db.Decimal(10, 2)
  status            String    @default("pending") // "pending" | "processing" | "completed" | "failed"
  method            String    // "paypal" | "stripe" | "bank_transfer"

  // Metadata
  earningsCount     Int       @default(0) @map("earnings_count") // How many earnings included
  periodStart       DateTime  @map("period_start")
  periodEnd         DateTime  @map("period_end")

  // Payment details
  transactionId     String?   @map("transaction_id") // PayPal/Stripe transaction ID
  paymentEmail      String?   @map("payment_email") // Email used for payment
  failureReason     String?   @map("failure_reason") @db.Text
  adminNotes        String?   @map("admin_notes") @db.Text

  // Fees
  processingFee     Decimal?  @map("processing_fee") @db.Decimal(10, 2)
  netAmount         Decimal?  @map("net_amount") @db.Decimal(10, 2) // Amount after fees

  // Timestamps
  initiatedAt       DateTime  @default(now()) @map("initiated_at")
  processedAt       DateTime? @map("processed_at")
  completedAt       DateTime? @map("completed_at")
  failedAt          DateTime? @map("failed_at")

  creator           Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  earnings          CreatorEarning[]

  @@index([creatorId, status])
  @@index([status, initiatedAt])
  @@index([completedAt])
  @@map("payouts")
}