datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ESSENTIAL MODELS ONLY - ULTRA MVP
// ============================================================================

enum UserRole {
  user
  admin
}

// Core user model
model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  role             UserRole @default(user)
  isEmailVerified  Boolean  @default(false) @map("is_email_verified")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  savedSearches           SavedSearch[]
  favoriteDestinations    FavoriteDestination[]

  @@map("users")
}

// Email verification tokens
model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Saved searches for logged-in users
model SavedSearch {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  originAirport      String   @map("origin_airport")
  theme              String?
  minFlightTime      Int?     @map("min_flight_time")
  maxFlightTime      Int?     @map("max_flight_time")
  priceAlertEnabled  Boolean  @default(false) @map("price_alert_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

// Favorite destinations for logged-in users
model FavoriteDestination {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  destinationId String   @map("destination_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([userId])
  @@map("favorite_destinations")
}

// Affiliate click tracking for commission attribution
model AffiliateClick {
  id            String    @id @default(uuid())
  userId        String?   @map("user_id")  // Optional - null for anonymous users
  destinationId String?   @map("destination_id")  // Which destination they were viewing
  partner       String    // "skyscanner", "kayak", "google_flights"
  clickUrl      String    @map("click_url") @db.Text  // Full affiliate URL clicked

  // Search context (what they were searching for)
  originAirport      String?  @map("origin_airport")
  destinationAirport String?  @map("destination_airport")

  // Tracking data
  referrer      String?   @db.Text  // HTTP referrer
  ipAddress     String?   @map("ip_address")  // For fraud detection
  userAgent     String?   @map("user_agent") @db.Text  // Browser/device info

  // Conversion tracking (updated by webhooks if partner supports it)
  converted     Boolean   @default(false)  // Did this click result in a booking?
  convertedAt   DateTime? @map("converted_at")  // When conversion happened
  commission    Decimal?  @db.Decimal(10, 2)  // Commission earned (if known)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([destinationId])
  @@index([partner])
  @@index([createdAt])
  @@index([converted])
  @@map("affiliate_clicks")
}

// Airport data
model Airport {
  id           String   @id @default(uuid())
  iataCode     String   @unique @map("iata_code")
  name         String
  city         String
  country      String
  latitude     Decimal?
  longitude    Decimal?
  isActive     Boolean  @default(true) @map("is_active")
  isSearchable Boolean  @default(false) @map("is_searchable")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  originFlights      FlightRoute[]        @relation("OriginAirport")
  destinationFlights FlightRoute[]        @relation("DestinationAirport")
  destinations       DestinationAirport[]

  @@index([isSearchable])
  @@map("airports")
}

// Flight routes and durations
model FlightRoute {
  id                        String    @id @default(uuid())
  originAirportCode         String    @map("origin_airport_code")
  destinationAirportCode    String    @map("destination_airport_code")
  totalDurationMinutes      Int       @map("total_duration_minutes")

  // Route verification fields
  isDirect                  Boolean?  @map("is_direct")           // null = unknown, true = direct flight exists, false = connections only
  isEstimated               Boolean   @default(true) @map("is_estimated")  // true = calculated estimate, false = real API data
  dataSource                String?   @map("data_source")         // "estimated", "amadeus", etc.
  lastUpdated               DateTime? @map("last_updated")        // When route data was last updated from API

  originAirport      Airport @relation("OriginAirport", fields: [originAirportCode], references: [iataCode])
  destinationAirport Airport @relation("DestinationAirport", fields: [destinationAirportCode], references: [iataCode])

  @@unique([originAirportCode, destinationAirportCode])
  @@index([isDirect])
  @@index([isEstimated])
  @@map("flight_routes")
}

// Countries
model Country {
  id           String        @id @default(uuid())
  name         String        @unique
  code         String        @unique  // ISO code: "US", "FR", "JP"
  imageUrl     String?       @map("image_url")  // Admin-uploaded country hero image
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  destinations Destination[]

  @@map("countries")
}

// Destinations with themes
model Destination {
  id              String     @id @default(uuid())
  airportCode     String?    @map("airport_code")  // Deprecated - kept for migration
  cityName        String     @map("city_name")
  countryName     String?    @map("country_name")  // Deprecated - kept for migration
  countryId       String?    @map("country_id")
  description     String?
  imageUrl        String?    @map("image_url")
  popularityScore Decimal?   @map("popularity_score")

  // SEO & URL fields
  slug            String?    @unique  // URL-friendly slug (e.g., "los-angeles")
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")

  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  country              Country?               @relation(fields: [countryId], references: [id])
  themePOIs            ThemePOI[]
  airports             DestinationAirport[]
  favoritedBy          FavoriteDestination[]

  @@index([countryId])
  @@map("destinations")
}

// Many-to-many relationship between Destinations and Airports
model DestinationAirport {
  id            String      @id @default(uuid())
  destinationId String      @map("destination_id")
  airportCode   String      @map("airport_code")
  isPrimary     Boolean     @default(false) @map("is_primary")
  createdAt     DateTime    @default(now()) @map("created_at")

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  airport       Airport     @relation(fields: [airportCode], references: [iataCode], onDelete: Cascade)

  @@unique([destinationId, airportCode])
  @@index([destinationId])
  @@index([airportCode])
  @@map("destination_airports")
}

// Theme-specific Points of Interest for destinations
model ThemePOI {
  id              String      @id @default(uuid())
  destinationId   String      @map("destination_id")
  theme           String      // "adventure", "nature", "vibe", "indulge", "discover"
  name            String
  description     String?
  videoUrl        String?     @map("video_url")  // DEPRECATED: Use POIVideo relation instead
  latitude        Decimal?
  longitude       Decimal?
  displayOrder    Int         @default(0) @map("display_order")

  // SEO Fields
  caption         String?     @db.Text // Instagram-style caption (50-100 words) for SEO and social
  altText         String?     @map("alt_text") @db.VarChar(255) // Image alt text for accessibility & SEO
  instagramUrl    String?     @map("instagram_url") // Link to Instagram post if applicable
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  destination     Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  videos          POIVideo[]

  @@index([destinationId, theme])
  @@map("theme_pois")
}

// Multiple videos per POI (YouTube Shorts feed)
model POIVideo {
  id              String      @id @default(uuid())
  poiId           String      @map("poi_id")
  videoUrl        String      @map("video_url")
  displayOrder    Int         @default(0) @map("display_order")

  // SEO Fields
  caption         String?     @db.Text // Instagram-style caption (50-100 words) for SEO and social
  altText         String?     @map("alt_text") @db.VarChar(255) // Image alt text for accessibility & SEO
  instagramUrl    String?     @map("instagram_url") // Link to Instagram post if applicable
  createdAt       DateTime    @default(now()) @map("created_at")

  poi             ThemePOI    @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@index([poiId])
  @@map("poi_videos")
}

// Basic search sessions
model SearchSession {
  id               String    @id @default(uuid())
  originAirport    String?   @map("origin_airport")
  destinationAirport String? @map("destination_airport")
  departureDate    String?   @map("departure_date")
  returnDate       String?   @map("return_date")
  passengers       Int       @default(1)
  preferences      Json?
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("search_sessions")
}

// Flight offer caching for Amadeus API responses
model OfferCache {
  id            String   @id @default(cuid())
  queryHash     String   @map("query_hash") @db.VarChar(64)
  market        String
  query         Json         // NormalizedQuery
  offers        Json         // FlightOffer[]
  offerCount    Int      @map("offer_count")
  dataSource    String   @default("amadeus") @map("data_source")
  isStale       Boolean  @default(false) @map("is_stale")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([queryHash])
  @@index([expiresAt, isStale])
  @@map("offer_cache")
}