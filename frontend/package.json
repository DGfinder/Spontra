{
    "name": "spontra-frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && prisma migrate deploy && next build",
        "start": "next start",
        "lint": "next lint",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:integration": "vitest run tests/integration/",
        "test:performance": "vitest run tests/performance/",
        "test:contracts": "vitest run tests/integration/api-contracts.test.ts",
        "test:user-journey": "vitest run tests/integration/user-journey.test.ts",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest watch",
        "test:ui": "vitest --ui",
        "postinstall": "prisma generate",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:migrate:reset": "prisma migrate reset",
        "db:migrate:status": "prisma migrate status",
        "db:studio": "prisma studio",
        "db:seed": "tsx prisma/seed.ts",
        "migrate:safe": "tsx scripts/migration-safety.ts migrate",
        "migrate:info": "tsx scripts/migration-safety.ts info",
        "admin:create": "tsx scripts/create-admin-user.ts create",
        "admin:update": "tsx scripts/create-admin-user.ts update",
        "admin:list": "tsx scripts/create-admin-user.ts list",
        "admin:delete": "tsx scripts/create-admin-user.ts delete",
        "email:test": "tsx scripts/test-email.ts",
        "sentry:test": "tsx scripts/test-sentry.ts",
        "analyze": "ANALYZE=true npm run build",
        "analyze:bundle": "npx @next/bundle-analyzer",
        "perf:audit": "lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-results.json",
        "perf:ci": "lhci autorun",
        "perf:budget": "bundlesize",
        "perf:audit-rsc": "tsx scripts/audit-rsc-boundaries.ts",
        "metasearch:seed": "tsx prisma/seedMetasearch.ts",
        "metasearch:test": "tsx scripts/test-metasearch.ts",
        "validation:all": "tsx scripts/pre-launch-validation.ts",
        "validation:postback": "tsx scripts/test-postback-signatures.ts",
        "validation:clicks": "tsx scripts/test-click-idempotency.ts",
        "validation:reprice": "tsx scripts/test-reprice-gates.ts",
        "validation:legacy": "tsx scripts/go-live-validation.ts",
        "monitor:synthetic": "tsx scripts/synthetic-monitor-cron.ts",
        "monitor:run": "tsx scripts/synthetic-worker.ts",
        "seed:live": "tsx scripts/seed-it-live.ts",
        "bundle:size": "npx bundlesize",
        "ops:daily": "curl -s -H 'x-api-key: $ADMIN_API_KEY' http://localhost:3000/api/admin/dashboards/daily-ops | jq",
        "ops:reconcile": "tsx scripts/nightly-reconciliation.ts",
        "deploy:day0": "./scripts/day-0-deploy.sh",
        "sanity:citycodes": "vitest run src/lib/cityCodes.test.ts",
        "sanity:landed": "curl -s 'http://localhost:3000/landed?clickId=TEST_CLICK' -o /dev/null -w '%{http_code}\\n'",
        "db:indexes": "psql $DATABASE_URL -f scripts/add-performance-indexes.sql",
        "perf:ops": "ab -n 50 -c 10 http://localhost:3000/api/admin/dashboards/daily-ops",
        "test:ops-shape": "tsx scripts/assert-daily-ops-shape.ts",
        "ops:critical": "npm run ops:daily | jq '{critical: [.epcByProviderMarket[] | select(.status==\"CRITICAL\")], price: [.priceChangeRates[]|select(.status==\"CRITICAL\")], synth: [.syntheticFailures15m[]|select(.status==\"CRITICAL\")]}'",
        "ops:regressions": "npm run ops:daily | jq '.epcByProviderMarket | sort_by(.changePctVs7d) | .[0:5]'",
        "ops:triage": "npm run ops:daily | jq -r '\"📊 DAILY OPS TRIAGE - \" + .generatedAt, \"Health: \" + (.summary.overallHealth|tostring) + \"%\", \"Critical: \" + (.summary.criticalIssues|length|tostring), (.summary.criticalIssues[] // \"✅ No critical issues\")'",
        "hygiene:nightly": "tsx scripts/data-hygiene.ts --verbose",
        "hygiene:report": "tsx scripts/data-hygiene.ts --report-only",
        "hygiene:dry-run": "tsx scripts/data-hygiene.ts --dry-run --verbose",
        "docs:api": "tsx scripts/generate-api-docs.ts",
        "docs:api:serve": "tsx scripts/generate-api-docs.ts --serve",
        "docs:api:markdown": "tsx scripts/generate-api-docs.ts --format markdown",
        "docs:validate": "tsx scripts/generate-api-docs.ts --no-validate"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.0",
        "@heroicons/react": "^2.1.5",
        "@hookform/resolvers": "^3.9.1",
        "@neondatabase/serverless": "^0.10.5",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/sdk-node": "^0.54.0",
        "@opentelemetry/auto-instrumentations-node": "^0.54.0",
        "@opentelemetry/resources": "^1.28.0",
        "@opentelemetry/semantic-conventions": "^1.28.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.54.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.54.0",
        "@opentelemetry/sdk-trace-node": "^1.28.0",
        "@opentelemetry/sdk-metrics": "^1.28.0",
        "@opentelemetry/exporter-prometheus": "^0.54.0",
        "@prisma/client": "^6.17.0",
        "@vercel/postgres": "^0.10.0",
        "@vercel/kv": "^3.0.0",
        "@vercel/analytics": "^1.5.0",
        "@vercel/speed-insights": "^1.2.0",
        "resend": "^4.0.1",
        "react-email": "^3.0.2",
        "@react-email/components": "^0.7.0",
        "@sentry/nextjs": "^8.40.0",
        "@types/node": "^22.9.1",
        "@types/pg": "^8.15.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/uuid": "^10.0.0",
        "autoprefixer": "^10.4.20",
        "web-vitals": "^4.2.4",
        "axios": "^1.7.9",
        "bcryptjs": "^2.4.3",
        "cassandra-driver": "^4.8.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "ioredis": "^5.4.1",
        "jose": "^5.9.6",
        "lucide-react": "^0.469.0",
        "next": "^15.5.4",
        "pg": "^8.16.3",
        "postcss": "^8.5.1",
        "prom-client": "^15.1.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.54.0",
        "@tanstack/react-query": "^5.61.3",
        "tailwind-merge": "^2.6.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "uuid": "^11.0.2",
        "zod": "^3.24.1",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@tailwindcss/forms": "^0.5.9",
        "@tailwindcss/typography": "^0.5.15",
        "@types/bcryptjs": "^2.4.6",
        "@vitest/coverage-v8": "^2.2.0",
        "@vitest/ui": "^2.2.0",
        "bundlesize": "^0.18.2",
        "@next/bundle-analyzer": "^15.5.4",
        "lighthouse": "^12.2.1",
        "@lhci/cli": "^0.15.0",
        "eslint": "^9.15.0",
        "eslint-config-next": "^15.5.4",
        "msw": "^2.8.0",
        "@pact-foundation/pact": "^13.1.3",
        "prettier": "^3.4.2",
        "prisma": "^6.17.0",
        "vitest": "^2.2.0",
        "webpack-bundle-analyzer": "^4.10.2"
    },
    "bundlesize": [
        {
            "path": ".next/static/js/pages/index.js",
            "maxSize": "120 kB",
            "compression": "gzip"
        },
        {
            "path": ".next/static/js/pages/flights.js", 
            "maxSize": "150 kB",
            "compression": "gzip"
        },
        {
            "path": ".next/static/js/pages/booking.js",
            "maxSize": "180 kB", 
            "compression": "gzip"
        },
        {
            "path": ".next/static/js/chunks/framework-*.js",
            "maxSize": "130 kB",
            "compression": "gzip"
        },
        {
            "path": ".next/static/js/chunks/main-*.js",
            "maxSize": "25 kB",
            "compression": "gzip"
        },
        {
            "path": ".next/static/css/**/*.css",
            "maxSize": "40 kB",
            "compression": "gzip"
        }
    ]
}
