{
    "compilerOptions":  {
                            "target":  "es2022",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "es2022"
                                    ],
                            "allowJs":  true,
                            "skipLibCheck":  true,
                            "strict":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "preserve",
                            "incremental":  true,
                            "downlevelIteration":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ],
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "./src/*"
                                                  ],
                                          "@/components/*":  [
                                                                 "./src/components/*"
                                                             ],
                                          "@/lib/*":  [
                                                          "./src/lib/*"
                                                      ],
                                          "@/server/*":  [
                                                             "./src/server/*"
                                                         ],
                                          "@/types/*":  [
                                                            "./src/types/*"
                                                        ],
                                          "@/hooks/*":  [
                                                            "./src/hooks/*"
                                                        ],
                                          "@/utils/*":  [
                                                            "./src/utils/*"
                                                        ]
                                      }
                        },
    "include":  [
                    "next-env.d.ts",
                    "**/*.ts",
                    "**/*.tsx",
                    ".next/types/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "tests",
                    "vitest.config.ts",
                    "src/lib/__tests__",
                    "**/*.test.ts",
                    "**/*.test.tsx",
                    "src/app/api/test-error/**",
                    "src/app/api/debug/**", 
                    "src/app/api/debugEnv/**",
                    "src/lib/healthChecks.ts",
                    "src/lib/monitoring.ts",
                    "src/lib/slaMonitoring.ts",
                    "src/lib/syntheticMonitorPro.ts",
                    "src/lib/businessMetrics.ts",
                    "src/lib/performanceRUM.ts",
                    "src/lib/productionAlerts.ts",
                    "src/lib/priceAccuracyThrottling.ts",
                    "src/lib/rateLimitProduction.ts",
                    "src/lib/metasearch/providerOptimizer.ts",
                    "src/lib/serverActionsTelemetry.ts",
                    "src/lib/telemetry.ts",
                    "src/lib/middlewareUtils.ts",
                    "src/lib/lazy-imports.tsx",
                    "src/lib/infantsSupportValidation.ts"
                ]
}
