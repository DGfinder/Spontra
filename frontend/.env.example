# Amadeus API Configuration
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
AMADEUS_ENVIRONMENT=test

# Backend API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
NEXT_PUBLIC_DATA_INGESTION_URL=http://localhost:8083

# Application Configuration
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Database Configuration - Vercel Postgres
# Vercel automatically provides these in production
POSTGRES_URL="postgres://username:password@host/database"
POSTGRES_PRISMA_URL="postgres://username:password@host/database?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://username:password@host/database"
POSTGRES_USER="username"
POSTGRES_HOST="host"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="database"

# Legacy support for existing Prisma configuration
DATABASE_URL=$POSTGRES_PRISMA_URL
DIRECT_URL=$POSTGRES_URL_NON_POOLING

# Legacy Infrastructure (deprecated)
#CASSANDRA_HOSTS=localhost
#CASSANDRA_KEYSPACE=spontra
#ELASTICSEARCH_URL=http://localhost:9200

# Vercel KV (Redis replacement)
# Vercel automatically provides these in production
KV_URL="redis://username:password@host:port"
KV_REST_API_URL="https://host/redis-rest-api"
KV_REST_API_TOKEN="token"
KV_REST_API_READ_ONLY_TOKEN="readonly-token"

# Legacy Redis (deprecated in favor of Vercel KV)
# REDIS_URL=redis://localhost:6379

# External Services
YOUTUBE_API_KEY=your_youtube_api_key_here

# Security - CRITICAL FOR PRODUCTION
# Generate secure 64+ character random strings for production
# Use: openssl rand -base64 64
JWT_SECRET=generate_secure_64char_secret_for_production
USER_AUTH_JWT_SECRET=generate_secure_64char_secret_for_production  
ENCRYPTION_KEY=generate_secure_64char_secret_for_production

# Admin JWT Configuration
ADMIN_JWT_SECRET=generate_secure_64char_secret_for_admin_production
ADMIN_JWT_ISSUER=spontra-admin
ADMIN_JWT_AUDIENCE=spontra-admin-panel

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_METRICS=false

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Theme Configuration
NEXT_PUBLIC_SUPPORTED_THEMES=party,adventure,learn,shopping,nature
NEXT_PUBLIC_DEFAULT_THEME=adventure

# Feature Flags
NEXT_PUBLIC_ENABLE_MOCK_FALLBACKS=false
NEXT_PUBLIC_DEBUG_LOGGING=false

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@spontra.com
NEXT_PUBLIC_APP_URL=https://spontra.com

# Error Tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ENABLED=false

# Affiliate Program IDs - REQUIRED FOR PRODUCTION REVENUE
# Register with each affiliate program to get your IDs
AFFILIATE_KAYAK_ID=your_kayak_affiliate_id_here
AFFILIATE_SKYSCANNER_ID=your_skyscanner_affiliate_id_here
AFFILIATE_TRAVELPAYOUTS_ID=your_travelpayouts_affiliate_id_here