# Production-Ready Frontend Dockerfile for Next.js
# Multi-stage build with security hardening and optimization

# ============================================================================
# DEPENDENCIES STAGE - Install and cache dependencies
# ============================================================================
FROM node:18-alpine AS dependencies

# Security: Update system packages and install security updates
RUN apk update && apk upgrade && \
    apk add --no-cache \
    libc6-compat \
    dumb-init \
    && rm -rf /var/cache/apk/*

# Create app directory and set permissions
WORKDIR /app

# Copy package files for dependency installation
COPY package*.json ./
COPY prisma ./prisma/

# Install dependencies with audit and security checks
RUN npm ci --only=production --no-audit --prefer-offline --no-fund && \
    npm cache clean --force

# ============================================================================
# BUILD STAGE - Build the application
# ============================================================================
FROM node:18-alpine AS builder

# Install build dependencies
RUN apk add --no-cache libc6-compat python3 make g++

WORKDIR /app

# Copy dependencies from previous stage
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .

# Set build-time environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Generate Prisma client and build application
RUN npx prisma generate && \
    npm run build && \
    npm prune --production

# ============================================================================
# SECURITY SCANNING STAGE - Scan for vulnerabilities
# ============================================================================
FROM aquasec/trivy:latest AS security-scan

# Copy application files for scanning
COPY --from=builder /app /scan-target

# Run security scan (fail on HIGH and CRITICAL vulnerabilities)
RUN trivy fs --exit-code 1 --severity HIGH,CRITICAL --no-progress /scan-target

# ============================================================================
# PRODUCTION STAGE - Final optimized image
# ============================================================================
FROM node:18-alpine AS production

# Security: Install dumb-init and security updates
RUN apk update && apk upgrade && \
    apk add --no-cache \
    dumb-init \
    curl \
    && rm -rf /var/cache/apk/* \
    && npm install -g npm@latest

WORKDIR /app

# Create non-root user with specific UID/GID
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs

# Set production environment
ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1

# Copy necessary files from builder stage
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json

# Set proper permissions
RUN chown -R nextjs:nodejs /app && \
    chmod -R 755 /app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

# Security: Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start the application
CMD ["node", "server.js"]

# ============================================================================
# METADATA - Image labels for production tracking
# ============================================================================
LABEL maintainer="Spontra Team <tech@spontra.com>" \
      version="1.0" \
      description="Production Next.js frontend for Spontra travel platform" \
      org.opencontainers.image.title="spontra-frontend" \
      org.opencontainers.image.description="Spontra frontend application" \
      org.opencontainers.image.vendor="Spontra" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.created="$(date -u +'%Y-%m-%dT%H:%M:%SZ')" \
      security.scan="trivy" \
      security.non-root="true"